    /* ═══════════ Modal ═══════════ */
    let navDir = 1, instantNext = false, closeTimer;

    modal.addEventListener("click", e => {
      const b = e.target.closest("button");
      if (b && b.textContent.trim().startsWith("←")) navDir = -1;
    }, true);

    let outTimer = 0, outTick = 0;
    function stopOutTimer() { clearTimeout(outTimer); clearInterval(outTick); }
    function studentOutBtn() { return `<button class="out-btn" id="outBtn" onclick="studentLogout()">Akkauntdan chiqish</button>`; }
    function studentLogout(auto) {
      stopOutTimer(); saveProfile(null); closeModal();
      showToast(auto ? "Vaqt tugadi — akkauntdan chiqdingiz" : "Akkauntdan chiqdingiz");
    }
    function armAutoLogout(sec) {
      const b = document.getElementById("outBtn"); if (!b) return;
      let left = sec; b.classList.add("go");
      const paint = () => { b.textContent = `Akkauntdan chiqish (${left})`; };
      paint();
      outTick = setInterval(() => { left--; if (left > 0) paint(); }, 1000);
      outTimer = setTimeout(() => studentLogout(true), sec * 1000);
    }

    function showModal(html) {
      stopOutTimer();
      clearTimeout(closeTimer);
      const wasOpen = overlay.classList.contains("show") && !overlay.classList.contains("closing");
      const from = wasOpen ? modal.offsetHeight : 0;
      overlay.classList.remove("closing");

      modal.innerHTML = `<div class="screen ${navDir < 0 ? "back" : ""} ${instantNext ? "static" : ""}">${html}</div>`;
      navDir = 1; instantNext = false;

      overlay.classList.add("show");
      document.body.classList.add("modal-open");
      document.body.style.overflow = "hidden";

      if (wasOpen) {
        const to = modal.offsetHeight;
        if (!reduce && from && to && from !== to) {
          modal.animate([{ height: from + "px" }, { height: to + "px" }], { duration: 560, easing: "cubic-bezier(.2,.8,.2,1)" });
        }
      } else {
        modal.style.animation = "none"; void modal.offsetWidth; modal.style.animation = "";
      }
      bindRoleGlow();
    }

    function closeModal() {
      if (!overlay.classList.contains("show") || overlay.classList.contains("closing")) return;
      overlay.classList.add("closing");
      document.body.classList.remove("modal-open");
      document.body.style.overflow = "";
      closeTimer = setTimeout(() => overlay.classList.remove("show", "closing"), reduce ? 0 : 300);
    }

    function outsideClose(event) {
      if (event.target === overlay) { stopCamera(); closeModal(); }
    }

    document.addEventListener("keydown", e => {
      if (e.key === "Escape" && overlay.classList.contains("show")) { stopCamera(); closeModal(); }
    });

    function bindRoleGlow() {
      modal.querySelectorAll(".role").forEach(el => {
        el.addEventListener("pointermove", e => {
          const r = el.getBoundingClientRect();
          el.style.setProperty("--mx", (e.clientX - r.left) + "px");
          el.style.setProperty("--my", (e.clientY - r.top) + "px");
        });
      });
    }

    function shake(ids) {
      ids.forEach(id => {
        const el = document.getElementById(id);
        if (el) { el.classList.remove("shake"); void el.offsetWidth; el.classList.add("shake"); }
      });
    }

    function openRegister() {
      stopCamera();
      showModal(`
        <div class="modal-head">
          <div>
            <h2>Platformaga xush kelibsiz</h2>
            <p class="subtle">Davom etish uchun profilingizni tanlang.</p>
          </div>
          <button class="close" onclick="closeModal()" aria-label="Yopish">×</button>
        </div>

        <div class="role-grid two">
          <button class="role" style="--k:0" onclick="renderParentForm()">
            <span class="role-emoji"><svg viewBox="0 0 24 24" aria-hidden="true"><circle pathLength="100" cx="9" cy="8" r="3.2"/><path pathLength="100" d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle pathLength="100" cx="17.5" cy="9" r="2.4"/><path pathLength="100" d="M17 14.2c2.4.3 4.2 2.3 4.2 4.8"/></svg></span>
            <div><b>Ota-ona</b><span class="sub">Farzand holatini ko‘rish</span></div>
          </button>
          <button class="role" style="--k:1" onclick="renderAdminLogin()">
            <span class="role-emoji"><svg viewBox="0 0 24 24" aria-hidden="true"><path pathLength="100" d="M12 3 4.5 6v5.5c0 4.6 3.1 8.2 7.5 9.5 4.4-1.3 7.5-4.9 7.5-9.5V6L12 3Z"/><path pathLength="100" d="m8.8 12.2 2.3 2.3 4.2-4.6"/></svg></span>
            <div><b>Admin</b><span class="sub">Maktab paneli</span></div>
          </button>
        </div>
      `);
    }


    /* ═══════════ Ota-ona / O'quvchi bo'limi ═══════════ */
    const PROFILE_KEY = "aloqa_profile";
    let profile = null;
    try { profile = JSON.parse(localStorage.getItem(PROFILE_KEY) || "null"); } catch (e) {}
    if (!profile || !students[profile.index] || !["parent", "student"].includes(profile.role)) profile = null;
    function saveProfile(p) {
      profile = p;
      try { p ? localStorage.setItem(PROFILE_KEY, JSON.stringify(p)) : localStorage.removeItem(PROFILE_KEY); } catch (e) {}
    }

    const IC = {
      parent: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle pathLength="100" cx="9" cy="8" r="3.2"/><path pathLength="100" d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle pathLength="100" cx="17.5" cy="9" r="2.4"/><path pathLength="100" d="M17 14.2c2.4.3 4.2 2.3 4.2 4.8"/></svg>',
      cam: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l1.6-2h6.8L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>',
      student: '<svg viewBox="0 0 24 24" aria-hidden="true"><path pathLength="100" d="M3 9.5 12 5l9 4.5-9 4.5-9-4.5Z"/><path pathLength="100" d="M7 12v4c0 1.4 2.2 2.5 5 2.5s5-1.1 5-2.5v-4"/><path pathLength="100" d="M21 9.5V15"/></svg>'
    };
    const UZ_DAYS = ["Yakshanba", "Dushanba", "Seshanba", "Chorshanba", "Payshanba", "Juma", "Shanba"];
    const UZ_MONTHS = ["yanvar", "fevral", "mart", "aprel", "may", "iyun", "iyul", "avgust", "sentyabr", "oktyabr", "noyabr", "dekabr"];
    function todayStr() { const d = new Date(); return `${UZ_DAYS[d.getDay()]}, ${d.getDate()}-${UZ_MONTHS[d.getMonth()]}`; }

    function roleBtn(k, icon, title, sub, action) {
      return `<button class="role" style="--k:${k}" onclick="${action}">
        <span class="role-emoji">${icon}</span>
        <div><b>${title}</b><span class="sub">${sub}</span></div>
      </button>`;
    }

    /* 1-ekran: Registratsiya + 3 ta tugma */
    function openHub() {
      stopCamera();
      const reg = profile
        ? `<div class="reg-done"><span class="reg-ok">✓</span><div><b>Siz ro‘yxatdan o‘tgansiz</b><small>${profile.role === "parent" ? "Ota-ona" : "O‘quvchi"} · ${escapeHtml(profile.name)}</small></div>${profile.role === "parent" ? '<button class="reg-out" onclick="hubLogout()">Chiqish</button>' : ""}</div>`
        : `<button class="hub-reg" id="hubReg" onclick="renderRegRole()"><span class="hub-step">1</span><div><b>Registratsiyadan o‘tish</b><small>Avval bir marta ro‘yxatdan o‘ting</small></div><span class="hub-go">→</span></button>`;
      showModal(`
        <div class="modal-head">
          <div>
            <h2>Farzandim bugun maktabga keldimi?</h2>
            <p class="subtle">Bir necha bosishda bilib oling.</p>
          </div>
          <button class="close" onclick="closeModal()" aria-label="Yopish">×</button>
        </div>
        ${reg}
        <div class="hub-label mono">${profile ? "Bo‘limni tanlang" : "2 · Ro‘yxatdan o‘tgach, bo‘limni tanlang"}</div>
        <div class="role-grid two">
          ${roleBtn(0, IC.parent, "Ota-ona", "Farzandim kelganmi?", "hubOpen('parent')")}
          ${roleBtn(1, IC.student, "O‘quvchi", "Dars jadvali", "hubOpen('student')")}
        </div>
      `);
    }

    function hubOpen(role) {
      if (!profile) {
        const b = document.getElementById("hubReg");
        if (b) { b.classList.remove("shake"); void b.offsetWidth; b.classList.add("shake"); }
        showToast("Avval registratsiyadan o‘ting");
        return;
      }
      if (profile.role !== role) {
        showToast(role === "parent" ? "Siz o‘quvchi sifatida ro‘yxatdan o‘tgansiz" : "Siz ota-ona sifatida ro‘yxatdan o‘tgansiz");
        return;
      }
      role === "parent" ? showParentStatus() : showSchedule();
    }

    function hubLogout() { saveProfile(null); showToast("Chiqdingiz"); openHub(); }

    /* 2-ekran: Ota-ona yoki O'quvchi */
    function renderRegRole() {
      showModal(`
        <div class="modal-head">
          <div>
            <h2>Registratsiya</h2>
            <p class="subtle">Siz kimsiz? Birini tanlang.</p>
          </div>
          <button class="close" onclick="closeModal()" aria-label="Yopish">×</button>
        </div>
        <div class="role-grid two">
          ${roleBtn(0, IC.parent, "Ota-ona", "Farzandim kelganini bilaman", "renderRegParent()")}
          ${roleBtn(1, IC.student, "O‘quvchi", "Dars jadvalimni ko‘raman", "renderRegStudent()")}
        </div>
        <button class="back" onclick="openHub()">← Orqaga</button>
      `);
    }

    function renderRegParent() {
      const rows = students.map((st, i) => `
        <div class="student" style="--k:${i}">
          <div class="student-pic">${st.initials}</div>
          <div class="student-info"><b>${st.name}</b><small>${st.class} sinf</small></div>
          <button class="check-btn" onclick="finishRegParent(${i})">Mening bolam</button>
        </div>`).join("");
      showModal(`
        <div class="modal-head">
          <div>
            <h2>Ota-ona registratsiyasi</h2>
            <p class="subtle">Ismingizni yozing va farzandingizni tanlang.</p>
          </div>
          <button class="close" onclick="closeModal()" aria-label="Yopish">×</button>
        </div>
        <div class="field">
          <label for="regName">Ism va familiya</label>
          <input id="regName" placeholder="Masalan, Dilnoza Karimova" autocomplete="name">
        </div>
        <div class="hub-label mono" style="margin:0 0 10px">Farzandingiz</div>
        <div class="list">${rows}</div>
        <button class="back" onclick="renderRegRole()">← Orqaga</button>
      `);
    }

    function finishRegParent(i) {
      const name = document.getElementById("regName").value.trim();
      if (!name) { shake(["regName"]); showToast("Avval ismingizni yozing"); document.getElementById("regName").focus(); return; }
      saveProfile({ role: "parent", name, index: i });
      showToast("Ro‘yxatdan o‘tdingiz ✓");
      showParentStatus();
    }

    function renderRegStudent() {
      const rows = students.map((st, i) => `
        <div class="student" style="--k:${i}">
          <div class="student-pic">${st.initials}</div>
          <div class="student-info"><b>${st.name}</b><small>${st.class} sinf</small></div>
          <button class="check-btn" onclick="finishRegStudent(${i})">Bu menman</button>
        </div>`).join("");
      showModal(`
        <div class="modal-head">
          <div>
            <h2>O‘quvchi registratsiyasi</h2>
            <p class="subtle">Ro‘yxatdan o‘zingizni toping.</p>
          </div>
          <button class="close" onclick="closeModal()" aria-label="Yopish">×</button>
        </div>
        <div class="list" style="margin-top:22px">${rows}</div>
        <button class="back" onclick="renderRegRole()">← Orqaga</button>
      `);
    }

    function finishRegStudent(i) {
      saveProfile({ role: "student", name: students[i].name, index: i });
      showToast("Ro‘yxatdan o‘tdingiz ✓");
      showSchedule();
    }

    /* Ota-ona: farzand kelganmi? */
    function showParentStatus() {
      const c = students[profile.index], here = c.present;
      const ph = here ? loadPhotos(profile.index) : null;
      const photosHtml = ph ? `<div class="hub-label mono">Bugungi rasmlar${ph.time ? " · soat " + ph.time : ""}</div><div class="photos">${ph.shots.map(u => `<img src="${u}" alt="${escapeHtml(c.name)}">`).join("")}</div><p class="subtle" style="font-size:12.5px;margin-top:8px">Farzandingiz skanerdan o‘tganda olingan rasmlar.</p>` : "";
      showModal(`
        <div class="modal-head">
          <div>
            <h2>Farzandim holati</h2>
            <p class="subtle">${escapeHtml(profile.name.split(" ")[0])}, bugun — ${todayStr()}</p>
          </div>
          <button class="close" onclick="closeModal()" aria-label="Yopish">×</button>
        </div>
        <div class="kid-card ${here ? "is-in" : "is-out"}">
          <div class="kid-top">
            <div class="student-pic big">${c.initials}</div>
            <div><b>${c.name}</b><small>${c.class} sinf</small></div>
          </div>
          <div class="kid-status">
            <span class="pulse-dot"></span>
            <div>
              <small>Bugungi holat</small>
              <strong>${here ? "Maktabga keldi" : "Hozircha kelmagan"}</strong>
              <em>${here ? "Davomat belgilandi" + (c.time ? " · soat " + c.time : "") : "Maktab davomatni hali belgilamagan"}</em>
            </div>
            <span class="kid-emoji">${here ? "✅" : "⏳"}</span>
          </div>
        </div>
        ${photosHtml}
        <div class="hub-actions">
          <button class="btn btn-primary" onclick="instantNext=true;showParentStatus();showToast('Yangilandi')">Yangilash</button>
        </div>
        <p class="subtle" style="font-size:12.5px;margin-top:14px">Hozircha demo ma’lumot: haqiqiy davomat maktab tizimiga ulangach shu yerda ko‘rinadi.</p>
        <button class="back" onclick="openHub()">← Bosh menyu</button>
      `);
    }

    /* O'quvchi: dars jadvali */
    const SCHEDULE = [
      ["Ona tili", "Matematika", "Ingliz tili", "Tabiiy fan", "Jismoniy tarbiya"],
      ["Matematika", "O‘qish", "Rus tili", "Tasviriy san’at", "Informatika"],
      ["Ona tili", "Matematika", "Tarix", "Ingliz tili", "Musiqa"],
      ["Matematika", "Ona tili", "Tabiiy fan", "Ingliz tili", "Mehnat"],
      ["O‘qish", "Matematika", "Rus tili", "Jismoniy tarbiya", "Sinf soati"],
      ["Ona tili", "Matematika", "Ingliz tili", "Tabiiy fan"]
    ];
    const LESSON_START = [8 * 60 + 30, 9 * 60 + 25, 10 * 60 + 20, 11 * 60 + 25, 12 * 60 + 20];
    const hhmm = m => `${String(Math.floor(m / 60)).padStart(2, "0")}:${String(m % 60).padStart(2, "0")}`;
    const SHORT_DAYS = ["Du", "Se", "Chor", "Pay", "Ju", "Sha"];

    function showSchedule() {
      const st = students[profile.index];
      const wd = new Date().getDay();            /* 0 = yakshanba */
      const todayIdx = wd === 0 ? -1 : wd - 1;
      const start = todayIdx < 0 ? 0 : todayIdx;
      const tabs = SHORT_DAYS.map((d, i) => `<button class="day ${i === start ? "active" : ""}" onclick="setDay(${i})"><small>${i === todayIdx ? "bugun" : ""}</small>${d}</button>`).join("");
      showModal(`
        ${studentOutBtn()}
        <div class="modal-head">
          <div>
            <h2>Dars jadvali</h2>
            <p class="subtle">${st.name} · ${st.class} sinf</p>
          </div>
          <button class="close" onclick="closeModal()" aria-label="Yopish">×</button>
        </div>
        <button class="arrive ${st.present ? "done" : ""}" onclick="arriveStart()">
          <span class="arrive-ic">${st.present ? "✓" : IC.cam}</span>
          <div><b>Kelganini aniqlash</b><small>${st.present ? "Bugun soat " + st.time + " da belgilangansiz" : "Yuz skaneri orqali “Keldim” deb belgilang"}</small></div>
          <span class="hub-go">→</span>
        </button>
        <div class="days">${tabs}</div>
        <div id="sched"></div>
        <p class="subtle" style="font-size:12.5px;margin-top:6px">Demo jadval: haqiqiy jadvalni maktab kiritadi.</p>
        <button class="back" onclick="openHub()">← Bosh menyu</button>
      `);
      setDay(start);
    }

    function setDay(i) {
      document.querySelectorAll(".day").forEach((b, k) => b.classList.toggle("active", k === i));
      const now = new Date(), wd = now.getDay(), mins = now.getHours() * 60 + now.getMinutes();
      const isToday = wd !== 0 && wd - 1 === i;
      document.getElementById("sched").innerHTML = SCHEDULE[i].map((name, k) => {
        const a = LESSON_START[k], live = isToday && mins >= a && mins < a + 45;
        return `<div class="lesson ${live ? "now" : ""}" style="--k:${k}">
          <span class="ln">${k + 1}</span>
          <div><b>${name}</b><small>${hhmm(a)} – ${hhmm(a + 45)}</small></div>
          ${live ? '<span class="live">Hozir</span>' : ""}
        </div>`;
      }).join("");
    }


    /* ═══════════ Kelganini aniqlash (o'quvchi) ═══════════ */
    const PRESENT_KEY = "aloqa_present";
    const dayKey = () => { const d = new Date(); return `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`; };
    function loadPresent() {
      try {
        const o = JSON.parse(localStorage.getItem(PRESENT_KEY) || "null");
        if (o && o.day === dayKey()) Object.entries(o.map).forEach(([i, t]) => { if (students[i]) { students[i].present = true; students[i].time = t; } });
      } catch (e) {}
    }
    function markPresent(i) {
      const n = new Date(), t = hhmm(n.getHours() * 60 + n.getMinutes());
      students[i].present = true; students[i].time = t;
      try {
        const o = JSON.parse(localStorage.getItem(PRESENT_KEY) || "null");
        const map = o && o.day === dayKey() ? o.map : {};
        map[i] = t;
        localStorage.setItem(PRESENT_KEY, JSON.stringify({ day: dayKey(), map }));
      } catch (e) {}
    }
    loadPresent();

    /* Skaner paytida olingan rasmlar (faqat muvaffaqiyatli o'tganda saqlanadi, kuniga bir marta yangilanadi) */
    const PHOTO_KEY = "aloqa_photos";
    function snapFrame(video) {
      try {
        const w = video.videoWidth, h = video.videoHeight; if (!w || !h) return null;
        const c = document.createElement("canvas"); c.width = 320; c.height = Math.round(h * 320 / w);
        c.getContext("2d").drawImage(video, 0, 0, c.width, c.height);
        return c.toDataURL("image/jpeg", 0.72);
      } catch (e) { return null; }
    }
    function savePhotos(i, shots) {
      if (!shots.length) return;
      try {
        const o = JSON.parse(localStorage.getItem(PHOTO_KEY) || "null");
        const map = o && o.day === dayKey() ? o.map : {};
        map[i] = { time: students[i].time, shots };
        localStorage.setItem(PHOTO_KEY, JSON.stringify({ day: dayKey(), map }));
      } catch (e) {}
    }
    function loadPhotos(i) {
      try {
        const o = JSON.parse(localStorage.getItem(PHOTO_KEY) || "null");
        return o && o.day === dayKey() && o.map[i] ? o.map[i] : null;
      } catch (e) { return null; }
    }

    
    function arriveStart() {
      if (students[profile.index].present) { renderArriveDone(profile.index, true); return; }
      renderArrive();
    }

    /* 1) Maktabdagi hamma o'quvchilar ro'yxati + qidiruv */
    function renderArrive() {
      stopCamera();
      showModal(`
        ${studentOutBtn()}
        <div class="modal-head">
          <div>
            <h2>Kelganini aniqlash</h2>
            <p class="subtle">Ro‘yxatdan o‘zingizni toping va “Bu men” tugmasini bosing.</p>
          </div>
          <button class="close" onclick="closeModal()" aria-label="Yopish">×</button>
        </div>
        <input class="search" id="arSearch" placeholder="Ism yoki sinf bo‘yicha qidirish…" oninput="filterArrive(this.value)" autocomplete="off">
        <div class="list scroll" id="arList"></div>
        <button class="back" onclick="showSchedule()">← Orqaga</button>
      `);
      filterArrive("");
      setTimeout(() => document.getElementById("arSearch")?.focus(), 120);
    }

    function filterArrive(q) {
      q = q.trim().toLowerCase();
      const items = students.map((st, i) => ({ st, i })).filter(({ st }) => !q || st.name.toLowerCase().includes(q) || st.class.toLowerCase().includes(q));
      document.getElementById("arList").innerHTML = items.length
        ? items.map(({ st, i }, k) => `
          <div class="student" style="--k:${Math.min(k, 8)}">
            <div class="student-pic">${st.initials}</div>
            <div class="student-info"><b>${st.name}</b><small>${st.class} sinf</small></div>
            <button class="check-btn" onclick="arriveSelect(${i})">Bu men</button>
          </div>`).join("")
        : `<div class="free">Hech kim topilmadi</div>`;
    }

    /* 2) "Bu men" — akkaunt tekshiruvi */
    function arriveSelect(i) {
      const me = students[profile.index], pick = students[i];
      if (pick.gender !== me.gender) { renderWrongAccount(); return; }
      if (i !== profile.index) { showToast("Bu siz emassiz — ro‘yxatdan o‘zingizni tanlang"); return; }
      renderFaceScan(i);
    }

    function renderWrongAccount(reason) {
      showModal(`
        <div class="modal-head">
          <div><h2>Kelganini aniqlash</h2></div>
          <button class="close" onclick="closeModal()" aria-label="Yopish">×</button>
        </div>
        <div class="err-card">
          <div class="err-ic">!</div>
          <h3>Siz boshqa odamning akkauntiga kirib ketgansiz</h3>
          <p>${reason === "scan" ? "Yuz skaneri bu akkaunt egasiga mos kelmadi." : "Tanlangan o‘quvchi bu akkaunt egasiga mos kelmadi."} O‘z akkauntingizdan kiring va qayta urinib ko‘ring.</p>
        </div>
        <div class="hub-actions">
          <button class="btn btn-ghost" onclick="renderArrive()">← Qayta urinish</button>
          <button class="btn btn-primary" onclick="hubLogout()">Akkauntdan chiqish</button>
        </div>
      `);
    }

    /* 3) Yuz skaneri */
    async function renderFaceScan(i) {
      showModal(`
        <div class="modal-head">
          <div>
            <h2>Yuzni skanerlash</h2>
            <p class="subtle">${students[i].name} · ${students[i].class} sinf</p>
          </div>
          <button class="close" onclick="closeCamera()" aria-label="Yopish">×</button>
        </div>
        <div class="camera-box">
          <video id="scanVideo" autoplay playsinline muted></video>
          <div class="camera-guide"><div class="face-frame"></div></div>
          <div class="scan-line"></div>
          <div class="camera-hint" id="scanHint">Kamera ochilmoqda…</div>
        </div>
        <div class="scan-prog"><i id="scanBar"></i></div>
        <div class="countdown" id="scanStatus">Yuzingizni oval ichiga joylang</div>
        <p class="subtle" style="font-size:12px;text-align:center;margin-bottom:6px">Skaner yuz orqali qiz yoki o‘g‘il bolaligini baholaydi. Yuzingiz tekshirilgach, jonli ekaningizni tasdiqlash uchun boshingizni buring. Muvaffaqiyatli o‘tsangiz, shu paytda olingan rasmlar ota-onangizga ko‘rsatiladi.</p>
        <button class="btn btn-ghost full" onclick="renderArrive()">Bekor qilish</button>
      `);
      const token = ++scanToken;
      try {
        if (!navigator.mediaDevices?.getUserMedia) throw new Error("no-camera");
        const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "user" }, audio: false });
        const video = document.getElementById("scanVideo");
        if (token !== scanToken || !video) { stream.getTracks().forEach(t => t.stop()); return; }
        cameraStream = stream;
        video.srcObject = stream;
        try { await video.play(); } catch (e) {}
        runScan(i, token, video);
      } catch (err) {
        if (token !== scanToken) return;
        stopCamera();
        renderCameraError(i, err);
      }
    }

    /* Yuzdan jinsni baholash modeli (brauzerning o'zida ishlaydi, rasm hech qayerga yuborilmaydi) */
    const FACE_LIB = "https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.12/dist/face-api.js";
    const FACE_MODELS = "https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.12/model/";
    let faceModelPromise = null;
    function loadFaceModel() {
      if (faceModelPromise) return faceModelPromise;
      faceModelPromise = new Promise((resolve, reject) => {
        const go = async () => {
          try {
            await faceapi.tf.ready();
            await Promise.all([
              faceapi.nets.tinyFaceDetector.loadFromUri(FACE_MODELS),
              faceapi.nets.faceLandmark68TinyNet.loadFromUri(FACE_MODELS),
              faceapi.nets.ageGenderNet.loadFromUri(FACE_MODELS)
            ]);
            resolve();
          } catch (e) { reject(e); }
        };
        if (window.faceapi) { go(); return; }
        const sc = document.createElement("script");
        sc.src = FACE_LIB; sc.onload = go; sc.onerror = () => reject(new Error("lib"));
        document.head.appendChild(sc);
      });
      faceModelPromise.catch(() => { faceModelPromise = null; });
      return faceModelPromise;
    }

    async function runScan(i, token, video) {
      const bar = document.getElementById("scanBar"), status = document.getElementById("scanStatus"), hint = document.getElementById("scanHint");
      hint.textContent = "Skaner tayyorlanmoqda…";
      status.textContent = "Model yuklanmoqda (birinchi marta biroz vaqt oladi)…";
      try { await loadFaceModel(); }
      catch (e) { if (token === scanToken) { stopCamera(); renderModelError(i); } return; }
      if (token !== scanToken) return;

      const me = students[i], expectFemale = me.gender === "qiz";
      const opts = new faceapi.TinyFaceDetectorOptions({ inputSize: 320, scoreThreshold: 0.5 });
      const NEED = 12;                    /* nechta yaxshi kadr kerak */
      let good = 0, sum = 0, lost = 0; const shots = [];
      hint.textContent = "Kameraga to‘g‘ri qarang";
      status.textContent = "Yuzingizni oval ichiga joylang";

      const tick = async () => {
        if (token !== scanToken) return;
        let r = null;
        try { r = await faceapi.detectSingleFace(video, opts).withFaceLandmarks(true).withAgeAndGender(); } catch (e) {}
        if (token !== scanToken) return;
        if (r) {
          const pFemale = r.gender === "female" ? r.genderProbability : 1 - r.genderProbability;
          sum += expectFemale ? pFemale : 1 - pFemale;   /* akkaunt egasiga mos kelish ehtimoli */
          good++; lost = 0;
          if ([3, 7, 11].includes(good)) { const sh = snapFrame(video); if (sh) shots.push(sh); }
          bar.style.width = (good / NEED * 100) + "%";
          status.textContent = `Skanerlanmoqda… ${Math.round(good / NEED * 100)}%`;
        } else {
          lost++;
          if (lost > 2) status.textContent = "Yuz topilmadi — kameraga qarang";
        }
        if (good >= NEED) {
          const match = sum / good;
          if (match >= 0.6) { runLiveness(i, token, video, opts, bar, status, hint, shots); return; }
          stopCamera();
          if (match <= 0.4) renderWrongAccount("scan");
          else renderScanUnsure(i);
        } else setTimeout(tick, 220);
      };
      tick();
    }

    /* Jonli odam tekshiruvi: rasm yoki ekrandagi tasvir bosh burolmaydi */
    function runLiveness(i, token, video, opts, bar, status, hint, shots) {
      const first = Math.random() < .5 ? "right" : "left";
      const steps = [first, first === "right" ? "left" : "right"];
      const say = d => d === "right" ? "Boshingizni sekin o‘ngga buring →" : "← Boshingizni sekin chapga buring";
      let k = 0, seenFront = false, t0 = Date.now();
      bar.style.width = "0%";
      hint.textContent = "Jonli odam tekshiruvi · 1/2";
      status.textContent = say(steps[0]);
      const tick = async () => {
        if (token !== scanToken) return;
        let r = null;
        try { r = await faceapi.detectSingleFace(video, opts).withFaceLandmarks(true); } catch (e) {}
        if (token !== scanToken) return;
        if (Date.now() - t0 > 12000) { stopCamera(); renderNotLive(i); return; }
        if (r) {
          const p = r.landmarks.positions;
          const yaw = (p[30].x - p[0].x) / (p[16].x - p[0].x);   /* 0.5 — to'g'ri qarayapti */
          if (yaw > .42 && yaw < .58) seenFront = true;
          const d = steps[k];
          if (seenFront && (d === "right" ? yaw < .38 : yaw > .62)) {
            k++; seenFront = false; t0 = Date.now();
            bar.style.width = (k / 2 * 100) + "%";
            if (k >= 2) {
              stopCamera(); markPresent(i); savePhotos(i, shots); renderArriveDone(i, false);
              return;
            }
            hint.textContent = "Jonli odam tekshiruvi · 2/2";
            status.textContent = say(steps[k]);
          }
        }
        setTimeout(tick, 120);
      };
      tick();
    }

