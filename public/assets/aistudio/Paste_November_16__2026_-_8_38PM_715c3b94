    /* Scroll: bitta rAF ichida avval hammasini o'qiydi, keyin yozadi (qotmaslik uchun) */
    let ticking = false, titleTy = 0;
    function frame() {
      ticking = false;
      const h = document.documentElement, y = h.scrollTop, vh = innerHeight;
      const maxS = h.scrollHeight - h.clientHeight || 1;
      /* — o'qish — */
      const rFill = fillSec.getBoundingClientRect(), rLive = liveCard.getBoundingClientRect(), rStory = storySec.getBoundingClientRect();
      const bandR = bands.map(b => b.getBoundingClientRect());
      const nextR = cards.map((c, i) => i < cards.length - 1 ? cards[i + 1].getBoundingClientRect() : null);
      const pR = pitems.map(o => o.el.getBoundingClientRect());
      /* — yozish — */
      progress.style.transform = `scaleX(${y / maxS})`;
      nav.classList.toggle("scrolled", y > 40);
      if (y < 2000) badgeEl.style.setProperty("--sy", y);
      scrollFx(y, rFill, rLive, rStory);
      bands.forEach((b, i) => {
        const r = bandR[i];
        if (r.bottom < 0 || r.top > vh) return;
        b.firstElementChild.style.transform = `translate3d(${(r.top + r.height / 2 - vh / 2) * .45}px,0,0)`;
      });
      cards.forEach((c, i) => {
        const r = nextR[i];
        if (!r) return;
        c.style.transform = `scale(${1 - clamp01(1 - r.top / vh) * .06})`;
      });
      pitems.forEach((o, i) => {
        const r = pR[i];
        if (r.bottom < -300 || r.top > vh + 300) return;
        o.ty = (r.top - o.ty + r.height / 2 - vh / 2) * o.k;
        o.el.style.translate = `0 ${o.ty.toFixed(1)}px`;
      });
      if (y < 1400) {
        titleTy = y * .18;
        htitle.style.translate = `0 ${titleTy.toFixed(1)}px`;
        htitle.style.opacity = Math.max(.15, 1 - y / 900).toFixed(3);
      }
    }
    function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(frame); } }
    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll);

    /* Reveal */
    const io = new IntersectionObserver(entries => {
      entries.forEach(en => { if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); } });
    }, { threshold: .15, rootMargin: "0px 0px -6% 0px" });
    document.querySelectorAll(".reveal").forEach(el => io.observe(el));

    /* Sanagichlar */
    function countUp(el) {
      const target = +el.dataset.count;
      if (reduce) { el.textContent = target; return; }
      const dur = 1900, start = performance.now();
      const tick = now => {
        const t = Math.min((now - start) / dur, 1);
        el.textContent = Math.round(target * (1 - Math.pow(1 - t, 4)));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
    const cio = new IntersectionObserver(entries => {
      entries.forEach(en => { if (en.isIntersecting) { countUp(en.target); cio.unobserve(en.target); } });
    }, { threshold: .5 });
    document.querySelectorAll("[data-count]").forEach(el => cio.observe(el));

    /* Sarlavhalarni so'zlarga bo'lish */
    function splitWords(el) {
      let i = 0;
      const walk = (node, cls) => {
        [...node.childNodes].forEach(n => {
          if (n.nodeType === 3) {
            const frag = document.createDocumentFragment();
            n.textContent.split(/(\s+)/).forEach(tok => {
              if (!tok) return;
              if (/^\s+$/.test(tok)) { frag.appendChild(document.createTextNode(" ")); return; }
              const w = document.createElement("span"); w.className = "sw";
              const ii = document.createElement("i"); ii.textContent = tok; ii.style.setProperty("--i", i++);
              if (cls) ii.className = cls;
              w.appendChild(ii); frag.appendChild(w);
            });
            n.replaceWith(frag);
          } else if (n.nodeType === 1) {
            walk(n, n.classList.contains("serif") ? "serif" : cls);
            n.replaceWith(...n.childNodes);
          }
        });
      };
      walk(el, "");
    }
    document.querySelectorAll(".sec-head h2, .cta h2").forEach(splitWords);

    /* Ripple */
    document.addEventListener("pointerdown", e => {
      if (reduce) return;
      const t = e.target.closest(".btn, .check-btn, .role, .close, .menu-btn");
      if (!t) return;
      const r = t.getBoundingClientRect(), s = Math.max(r.width, r.height) * 2;
      const d = document.createElement("span");
      d.className = "ripple";
      d.style.cssText = `width:${s}px;height:${s}px;left:${e.clientX - r.left - s / 2}px;top:${e.clientY - r.top - s / 2}px`;
      t.appendChild(d);
      setTimeout(() => d.remove(), 800);
    });

    /* Magnit tugmalar + maxsus kursor */
    if (finePointer && !reduce) {
      document.querySelectorAll(".mag").forEach(el => {
        el.addEventListener("pointermove", e => {
          const r = el.getBoundingClientRect();
          el.style.transform = `translate(${(e.clientX - (r.left + r.width / 2)) * .22}px, ${(e.clientY - (r.top + r.height / 2)) * .3}px)`;
        });
        el.addEventListener("pointerleave", () => { el.style.transform = ""; });
      });

      const ring = document.getElementById("cursor");
      let cx = -100, cy = -100, tx = cx, ty = cy;
      addEventListener("pointermove", e => { tx = e.clientX; ty = e.clientY; ring.style.opacity = 1; });
      document.addEventListener("pointerover", e => { ring.classList.toggle("big", !!e.target.closest("a, button, .row")); });
      document.addEventListener("pointerleave", () => { ring.style.opacity = 0; });
      (function loop() {
        const ddx = tx - cx, ddy = ty - cy;
        if (Math.abs(ddx) > .1 || Math.abs(ddy) > .1) {
          cx += ddx * .18; cy += ddy * .18;
          ring.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
        }
        requestAnimationFrame(loop);
      })();
    }

    /* ═════════ Yangi motion: scroll hikoyalari ═════════ */
    const clamp01 = v => Math.max(0, Math.min(1, v));
    const fillSec = document.getElementById("fill");
    const fillText = document.getElementById("fillText");
    const storySec = document.getElementById("kun");
    const storyLine = storySec.querySelector(".st-line");
    const stSteps = [...storySec.querySelectorAll(".st")];
    const phoneScreens = [...storySec.querySelectorAll(".ps")];
    const liveCard = document.getElementById("liveCard");
    const tickerSkew = document.querySelector(".ticker-skew");
    const fillNodes = [...fillSec.querySelectorAll(".node")];

    /* "Bu nima?" matni — so'zlarga bo'linadi, scroll bilan to'ladi */
    const fillWords = [];
    (function () {
      const walk = (node, hl) => {
        [...node.childNodes].forEach(n => {
          if (n.nodeType === 3) {
            const frag = document.createDocumentFragment();
            n.textContent.split(/(\s+)/).forEach(tok => {
              if (!tok) return;
              if (/^\s+$/.test(tok)) { frag.appendChild(document.createTextNode(" ")); return; }
              const s = document.createElement("span");
              s.className = "sf" + (hl ? " hl" : ""); s.textContent = tok;
              fillWords.push(s); frag.appendChild(s);
            });
            n.replaceWith(frag);
          } else if (n.nodeType === 1) {
            walk(n, n.tagName === "EM");
            n.replaceWith(...n.childNodes);
          }
        });
      };
      walk(fillText, false);
    })();

    let skewVel = 0, lastY = scrollY, skewRaf = 0;
    function skewLoop() {
      skewVel *= .88;
      tickerSkew.style.transform = `skewX(${(-skewVel * .09).toFixed(2)}deg)`;
      if (Math.abs(skewVel) > .05) skewRaf = requestAnimationFrame(skewLoop);
      else { skewRaf = 0; tickerSkew.style.transform = ""; }
    }

    let lastLit = -1, lastP1 = -1, lastP2 = -1, lastS = -1, lastIdx = -1;
    function scrollFx(y, rFill, rLive, rStory) {
      /* Ticker tezlikka qarab egiladi */
      const dv = y - lastY; lastY = y;
      if (Math.abs(dv) > 1) { skewVel = Math.max(-60, Math.min(60, skewVel * .5 + dv)); if (!skewRaf) skewRaf = requestAnimationFrame(skewLoop); }

      /* Matn to'lishi */
      let p = clamp01(-rFill.top / (rFill.height - innerHeight));
      const lit = Math.floor(clamp01(p * 1.25 - .06) * fillWords.length);
      if (lit !== lastLit) { fillWords.forEach((w, i) => w.classList.toggle("on", i < lit)); lastLit = lit; }
      const p1 = Math.round(p * 500) / 500;
      if (p1 !== lastP1) { fillFlow.style.setProperty("--p", p1); lastP1 = p1; }
      fillNodes.forEach((n, i) => n.classList.toggle("on", p > [.08, .38, .7][i]));

      /* Jonli davomat kartasi kattalashadi */
      const sc = Math.round((.9 + .1 * clamp01(1 - rLive.top / (innerHeight * .9))) * 500) / 500;
      if (sc !== lastS) { liveCard.style.setProperty("--s", sc); lastS = sc; }

      /* Telefon hikoyasi */
      p = clamp01(-rStory.top / (rStory.height - innerHeight));
      const p2 = Math.round(p * 500) / 500;
      if (p2 !== lastP2) { phoneEl.style.setProperty("--p", p2); storyLine.style.setProperty("--p", p2); lastP2 = p2; }
      const idx = Math.min(2, Math.floor(p * 3));
      if (idx !== lastIdx) {
        stSteps.forEach((s, i) => s.classList.toggle("active", i === idx));
        phoneScreens.forEach((s, i) => s.classList.toggle("active", i === idx));
        lastIdx = idx;
      }
    }

    /* Jonli davomat: ko'ringanda kataklar to'ladi */
    new IntersectionObserver((es, o) => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add("in"); o.unobserve(e.target); } }), { threshold: .3 })
      .observe(liveCard);

    /* Savollar (accordion) */
    document.querySelectorAll(".faq-q").forEach(b => b.addEventListener("click", () => {
      const item = b.parentElement, open = !item.classList.contains("open");
      document.querySelectorAll(".faq-item.open").forEach(i => { i.classList.remove("open"); i.firstElementChild.setAttribute("aria-expanded", false); });
      if (open) { item.classList.add("open"); b.setAttribute("aria-expanded", true); }
    }));

    /* Hero sarlavha: harflar kursorga javob beradi */
    const heroChars = [];
    document.querySelectorAll(".hero-title .w > i").forEach(el => {
      const txt = el.textContent.replace(/ /g, " ");
      el.textContent = "";
      [...txt].forEach(c => {
        const s = document.createElement("span");
        s.className = "ch"; s.textContent = c === " " ? " " : c;
        el.appendChild(s); heroChars.push(s);
      });
    });

    if (finePointer && !reduce) {
      const shapes = [...document.querySelectorAll(".shape")];
      const ring = document.getElementById("cursor");
      let charPos = [], lastF = [], lastMeasure = -9999, mx = 0, my = 0, pmRaf = 0;
      function measureChars() {
        charPos = heroChars.map(c => { const b = c.getBoundingClientRect(); return { x: b.left + b.width / 2 + scrollX, y: b.top + b.height / 2 + scrollY - titleTy }; });
        lastMeasure = performance.now();
      }
      addEventListener("resize", () => { lastMeasure = -9999; });
      function pmFrame() {
        pmRaf = 0;
        if (scrollY >= innerHeight * 1.2) return;
        if (performance.now() - lastMeasure > 1200) measureChars();
        const px = mx + scrollX, py = my + scrollY;
        for (let i = 0; i < heroChars.length; i++) {
          const q = charPos[i];
          const f = Math.max(0, 1 - Math.hypot(px - q.x, py - (q.y + titleTy)) / 190);
          if (Math.abs(f - (lastF[i] ?? -1)) > .015) { heroChars[i].style.setProperty("--f", f.toFixed(3)); lastF[i] = f; }
        }
        const nx = mx / innerWidth - .5, ny = my / innerHeight - .5;
        shapes.forEach(s => { const d = +s.dataset.depth; s.style.translate = `${nx * d}px ${ny * d}px`; });
      }
      addEventListener("pointermove", e => { mx = e.clientX; my = e.clientY; if (!pmRaf) pmRaf = requestAnimationFrame(pmFrame); }, { passive: true });
      /* Kartalar 3D egiladi + yorug'lik */
      document.querySelectorAll(".aud-card").forEach(card => {
        const inner = card.firstElementChild;
        card.addEventListener("pointermove", e => {
          const r = card.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
          inner.style.setProperty("--rx", ((x - .5) * 10).toFixed(2) + "deg");
          inner.style.setProperty("--ry", ((.5 - y) * 8).toFixed(2) + "deg");
          inner.style.setProperty("--gx", (x * 100) + "%"); inner.style.setProperty("--gy", (y * 100) + "%");
        });
        card.addEventListener("pointerleave", () => { inner.style.setProperty("--rx", "0deg"); inner.style.setProperty("--ry", "0deg"); });
      });
      /* Kursor yozuvi */
      document.addEventListener("pointerover", e => {
        const t = e.target.closest("[data-cursor]");
        ring.classList.toggle("lbl", !!t);
        ring.textContent = t ? t.dataset.cursor : "";
        if (t) ring.classList.remove("big");
      });
    }


    /* Parallax elementlari (hisob-kitob frame() ichida) */
    const pitems = [];
    [[".sec-head", .07], [".step-card .big", .1], [".live-right", .06], [".stat b", .05], [".badge", -.1], [".hero-lead", -.04], [".aud-ic", -.05]]
      .forEach(([sel, k]) => document.querySelectorAll(sel).forEach(el => pitems.push({ el, k, ty: 0 })));
    const htitle = document.querySelector(".hero-title");
    const badgeEl = document.querySelector(".badge");
    const phoneEl = storySec.querySelector(".phone");
    const fillFlow = fillSec.querySelector(".fill-flow");

    frame();

    /* Loader → sahifa ochilishi */
    let ready = false;
    function onReady() {
      if (ready) return;
      ready = true;
      document.body.classList.add("ready");
    }
    (function runLoader() {
      const loader = document.getElementById("loader");
      const lbar = document.getElementById("lbar");
      const lnum = document.getElementById("lnum");
      const minMs = reduce ? 200 : 2000;
      const t0 = performance.now();
      let loaded = document.readyState === "complete";
      addEventListener("load", () => { loaded = true; });
      function finish() {
        loader.classList.add("done");
        setTimeout(onReady, reduce ? 0 : 650);
        setTimeout(() => loader.classList.add("gone"), reduce ? 0 : 1500);
      }
      function step(now) {
        const t = Math.min((now - t0) / minMs, 1);
        const base = t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        const p = loaded ? base : Math.min(base, .9);
        lbar.style.transform = `scaleX(${p})`;
        lnum.textContent = Math.round(p * 100);
        if (p >= 1) finish(); else requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    })();
  </script>
</body>
</html>