.out-btn:hover{background:var(--bg)}
.out-btn.go{background:var(--ok);border-color:var(--ok);color:#fff;animation:outGlow 1s ease-in-out infinite}
@keyframes outGlow{0%,100%{box-shadow:0 0 0 0 rgba(39,174,96,.55)}50%{box-shadow:0 0 0 9px rgba(39,174,96,0)}}
  
/* Ota-ona ekranida bola rasmlari */
.photos{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:14px}
.photos img{width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:10px;border:1px solid var(--line);background:var(--bg)}
