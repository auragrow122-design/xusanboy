<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#2f80ed">
  <title>Aloqa — Maktab platformasi</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
:root{--pri:#2f80ed;--pri-d:#1f66c9;--pri-l:#e8f1fd;--bg:#f3f6fb;--card:#fff;--text:#1f2a37;--muted:#6b7a90;--line:#e3e9f2;--ok:#27ae60;--ok-l:#e6f6ec;--warn:#f2994a;--warn-l:#fff3e6;--err:#eb5757;--err-l:#fdeaea;--r:14px;--sh:0 2px 10px rgba(31,42,55,.06)}
*{box-sizing:border-box;margin:0}html{scroll-behavior:smooth}
body{min-height:100vh;background:var(--bg);color:var(--text);font:16px/1.55 Inter,"Segoe UI",Roboto,system-ui,sans-serif;-webkit-font-smoothing:antialiased}
button,input{font:inherit;color:inherit}button{cursor:pointer}a{color:inherit;text-decoration:none}
section[id]{scroll-margin-top:84px}.wrap{max-width:1140px;margin:0 auto;padding:0 20px}.mono{font-size:12px;font-weight:600;letter-spacing:.03em}
/* Tugmalar */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:11px 22px;border:1px solid transparent;border-radius:10px;font-weight:700;font-size:15px;transition:background .2s,box-shadow .2s,transform .1s}
.btn:active{transform:scale(.97)}
.btn-primary{background:var(--pri);color:#fff}.btn-primary:hover{background:var(--pri-d);box-shadow:0 4px 12px rgba(47,128,237,.35)}
.btn-ghost{background:#fff;border-color:var(--pri);color:var(--pri)}.btn-ghost:hover{background:var(--pri-l)}
.btn.full{width:100%;margin-top:12px}.btn-lg{padding:14px 28px;font-size:16px}
/* Sarlavha */
.nav-wrap{position:sticky;top:0;z-index:40;background:#fff;border-bottom:1px solid var(--line)}
.nav{position:relative;max-width:1140px;margin:0 auto;height:64px;padding:0 20px;display:flex;align-items:center;gap:28px;background:none;border:0;box-shadow:none;border-radius:0}
.brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:22px;color:var(--pri);letter-spacing:-.02em}
.brand::before{content:"A";width:34px;height:34px;border-radius:10px;background:var(--pri);color:#fff;display:grid;place-items:center;font-size:19px}
.nav-links{display:flex;gap:6px;margin-left:12px}.nav-links a{padding:8px 14px;border-radius:8px;font-weight:600;font-size:15px;color:#455468}.nav-links a:hover{background:var(--pri-l);color:var(--pri)}
.nav-right{margin-left:auto;display:flex;gap:10px;align-items:center}
.nav .btn-ghost{background:var(--pri);color:#fff;border-color:var(--pri)}.nav .btn-ghost:hover{background:var(--pri-d)}
.menu-btn{display:none;width:40px;height:40px;padding:10px 9px;border:1px solid var(--line);border-radius:10px;background:#fff;flex-direction:column;justify-content:space-between}
.menu-btn i{display:block;height:2px;background:var(--text);border-radius:2px}
.mobile-menu{display:none;position:absolute;top:100%;left:0;right:0;background:#fff;border-bottom:1px solid var(--line);padding:6px 20px 12px}.mobile-menu a{display:block;padding:12px 4px;font-weight:600;border-bottom:1px solid var(--line)}
.nav.menu-open .mobile-menu{display:block}
/* Keraksiz bezaklar yashiriladi (dizayn soddalashtirildi) */
.loader,.cursor,.progress-bar,.shape,.pill-inline,.badge,.band,.wordmark,.ripple,.phone-wrap,.st-line,.fline i,.arr,.fline.l2{display:none!important}
.mag,.step-card,.ticker-skew,.hero-title{transform:none!important}
.sec-head,.step-card .big,.live-right,.stat b,.hero-lead,.aud-ic,.hero-title{translate:none!important}.hero-title{opacity:1!important}
.serif{font-style:normal;color:var(--pri)}.mono{font-size:12px;font-weight:600;letter-spacing:.03em}
.sw,.sw i,.line,.w{display:inline}.sw i{font-style:normal}
/* Hero */
.hero{margin-top:24px;padding:44px 40px;background:#fff;border:1px solid var(--line);border-radius:18px;box-shadow:var(--sh)}
.hero-top{display:flex;gap:12px;align-items:center;color:var(--muted)}.hero-top span:first-child{padding:5px 12px;border-radius:99px;background:var(--pri-l);color:var(--pri);font-size:13px;font-weight:700}
.hero-title{margin:16px 0 0;font-size:clamp(32px,5vw,56px);line-height:1.1;letter-spacing:-.03em;font-weight:800}.hero-title .line{display:block}.hero-title .ch{display:inline}.hero-title .serif i{color:var(--pri)}
.hero-lead{max-width:560px;margin-top:18px;font-size:18px;color:#455468}.hero-lead b{color:var(--text)}.hero-lead em{font-style:normal;color:var(--pri);font-weight:600}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.chip{padding:6px 14px;border-radius:99px;border:1px solid var(--line);background:var(--bg);color:#455468}
.cta-row{display:flex;flex-wrap:wrap;align-items:center;gap:18px;margin-top:24px}.link-arrow{color:var(--pri);font-weight:700;font-size:15px}.link-arrow:hover{text-decoration:underline}
.ticker{max-width:1140px;margin:16px auto 0;padding:0 20px}.ticker-track{display:flex;flex-wrap:wrap;gap:8px}
.ticker-item{padding:7px 14px;border:1px solid var(--line);border-radius:99px;background:#fff;font-size:13px;color:#455468}.ticker-item b{margin-left:4px;color:var(--ok)}.ticker-item:nth-child(n+6){display:none}
/* Bo'limlar */
.sec.wrap{padding-top:56px}.sec-head{margin-bottom:24px}.sec-head h2,.cta h2{font-size:clamp(26px,3.2vw,34px);letter-spacing:-.02em;line-height:1.2}
.kicker{display:block;margin-bottom:6px;color:var(--pri);text-transform:uppercase;letter-spacing:.06em}
.fill-sec{margin-top:56px}.fill-in{display:block}.fill-text{max-width:820px;font-weight:700;font-size:clamp(24px,3.4vw,36px);line-height:1.3;letter-spacing:-.02em}.fill-text .sf.hl{color:var(--pri)}
.fill-flow{display:flex;align-items:center;gap:12px;margin-top:22px;flex-wrap:wrap}.node{padding:10px 18px;border-radius:10px;background:var(--pri-l);color:var(--pri);font-weight:700;font-size:14px}.fline{width:28px;height:2px;background:#b9c9e0}
section.live{margin-top:56px}.live-card{display:grid;grid-template-columns:1fr 1.3fr;gap:30px;padding:28px;background:#fff;border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--sh)}
.live-label{color:var(--pri);text-transform:uppercase}.live-num{font-size:56px;font-weight:800;line-height:1.1;color:var(--pri)}.live-num small{font-size:22px;color:var(--muted);font-weight:600}.live-text{margin-top:6px;color:var(--muted)}
.cells{display:grid;grid-template-columns:repeat(10,1fr);gap:6px}.cell{display:block;aspect-ratio:1;border-radius:6px;background:#dde6f3}.cell.on{background:var(--ok)}
.legend{display:flex;justify-content:space-between;margin:12px 0 8px;color:var(--ok);font-size:14px}.legend .off{color:var(--warn)}.live-right>.mono{color:var(--muted);font-weight:500}
.aud,.rows,.stack,.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.stats{grid-template-columns:repeat(4,1fr);margin-top:56px}
.aud-card,.row,.step-card,.stat,.st{background:#fff;border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--sh)}
.aud-card{cursor:pointer;transition:transform .2s,box-shadow .2s,border-color .2s}.aud-card:hover,.aud-card:focus-visible{transform:translateY(-4px);border-color:var(--pri);box-shadow:0 10px 24px rgba(47,128,237,.15);outline:0}
.aud-inner{height:100%;display:flex;flex-direction:column;gap:14px;padding:24px}.aud-inner>div:nth-child(2){flex:1}
.aud-ic{width:52px;height:52px;display:grid;place-items:center;border-radius:14px;background:var(--pri-l);color:var(--pri)}
.aud-ic svg,.role-emoji svg{width:28px;height:28px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}.aud-ic svg *{stroke-dasharray:none;stroke-dashoffset:0}
.aud-tag,.tag{display:inline-block;margin-bottom:10px;padding:4px 12px;border-radius:99px;background:var(--pri-l);color:var(--pri);font-weight:700}
.aud-card h3{margin-bottom:8px;font-size:20px;line-height:1.25}.aud-card p{color:var(--muted)}
.row{display:flex;flex-direction:column;gap:8px;padding:22px}.row .n{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--pri);color:#fff;font-weight:800;font-size:14px}.row h3{font-size:18px}.row p{color:var(--muted)}
.story{margin-top:56px}.story-pin{display:block}.story-grid{display:block}.story h2{font-size:clamp(26px,3.2vw,34px);letter-spacing:-.02em;line-height:1.2;margin-bottom:24px}
.st-wrap{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.st{padding:22px;border-top:4px solid var(--pri);opacity:1!important;transform:none!important}
.st span.mono{display:inline-block;margin-bottom:10px;padding:3px 10px;border-radius:8px;background:var(--pri-l);color:var(--pri)}.st h3{margin-bottom:6px;font-size:18px}.st p{max-height:none;color:var(--muted)}.demo-note{margin-top:12px;color:var(--muted);font-weight:500}
.step-card{position:relative;display:block;padding:22px;overflow:hidden}.step-card h3{margin-bottom:6px;font-size:18px}.step-card p{color:var(--muted)}
.step-card .big{position:absolute;right:16px;top:6px;font-size:64px;font-weight:800;color:var(--pri-l);line-height:1}
.stat{padding:22px;text-align:center}.stat b{display:block;font-size:38px;color:var(--pri);line-height:1.1}.stat .mono{color:var(--muted);font-size:14px}
.faq{display:grid;gap:10px}.faq-item{background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden}
.faq-q{width:100%;display:flex;align-items:center;gap:12px;padding:18px 20px;border:0;background:none;text-align:left;font-weight:700;font-size:17px}
.faq-q .n{color:var(--pri);font-size:13px}.faq-q .pm{margin-left:auto;width:22px;height:22px;position:relative;flex:none}
.faq-q .pm::before,.faq-q .pm::after{content:"";position:absolute;left:3px;right:3px;top:50%;height:2px;margin-top:-1px;background:var(--pri);transition:transform .25s}.faq-q .pm::after{transform:rotate(90deg)}
.faq-item.open .pm::after{transform:rotate(0)}.faq-item.open{border-color:var(--pri)}
.faq-a{display:grid;grid-template-rows:0fr;transition:grid-template-rows .3s}.faq-item.open .faq-a{grid-template-rows:1fr}.faq-a>div{overflow:hidden}.faq-a p{padding:0 20px 18px 46px;color:#455468}
.cta{margin-top:64px;background:var(--pri);color:#fff;text-align:center;padding:56px 0 22px}.cta h2{margin-bottom:10px}.cta p{opacity:.9;margin-bottom:22px}.cta .btn-primary{background:#fff;color:var(--pri)}
.foot{display:flex;justify-content:space-between;gap:8px;margin-top:44px;padding-top:18px;border-top:1px solid rgba(255,255,255,.25);font-weight:500;opacity:.85}
/* Modal */
.overlay{position:fixed;inset:0;z-index:60;display:none;align-items:center;justify-content:center;padding:20px;overflow-y:auto;background:rgba(31,42,55,.55)}
.overlay.show{display:flex;animation:fade .2s}.overlay.closing{animation:fadeOut .25s forwards}@keyframes fade{from{opacity:0}}@keyframes fadeOut{to{opacity:0}}
.modal{position:relative;width:min(560px,100%);max-height:92vh;padding:26px;overflow-y:auto;overflow-x:hidden;background:#fff;border-radius:18px;box-shadow:0 24px 70px rgba(0,0,0,.3);animation:pop .3s}
@keyframes pop{from{opacity:0;transform:translateY(16px)}}.screen{animation:screenIn .3s both}.screen.back{animation-name:screenInBack}.screen.static,.screen.static .student{animation:none}
@keyframes screenIn{from{opacity:0;transform:translateX(16px)}}@keyframes screenInBack{from{opacity:0;transform:translateX(-16px)}}
.modal-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.modal-head h2{margin-bottom:4px;font-size:24px;line-height:1.2;color:var(--text)}
.subtle{color:var(--muted);font-size:14px}.close{width:36px;height:36px;flex:none;border:0;border-radius:50%;background:var(--bg);font-size:22px;line-height:1}.close:hover{background:var(--line)}
.role-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:20px}.role-grid.two{grid-template-columns:repeat(2,1fr)}
.role{display:flex;flex-direction:column;gap:12px;padding:18px;text-align:left;border:1px solid var(--line);border-radius:14px;background:#fff;transition:.2s}
.role:hover{border-color:var(--pri);background:var(--pri-l)}.role b{display:block;font-size:16px}.role span.sub{color:var(--muted);font-size:13px}
.role-emoji{width:48px;height:48px;display:grid;place-items:center;border-radius:12px;background:var(--pri-l);color:var(--pri)}
.field{margin:16px 0}.field label{display:block;margin-bottom:6px;font-size:14px;font-weight:600}
.field input,.search{width:100%;padding:12px 14px;outline:0;border:1px solid #cfd8e6;border-radius:10px;background:#fff;transition:.2s}.search{margin-top:16px}
.field input:focus,.search:focus{border-color:var(--pri);box-shadow:0 0 0 3px rgba(47,128,237,.18)}.field input.shake{animation:shake .4s;border-color:var(--err)}
@keyframes shake{25%{transform:translateX(-6px)}50%{transform:translateX(6px)}75%{transform:translateX(-3px)}}
.back{padding:14px 0 0;border:0;background:none;color:var(--pri);font-weight:700}.back:hover{text-decoration:underline}
.list{display:grid;gap:8px;margin-top:16px}.list.scroll{max-height:340px;overflow-y:auto;padding-right:4px}
.student{display:flex;align-items:center;gap:12px;padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:#fff}.student:hover{background:var(--bg)}
.student-pic{width:42px;height:42px;flex:none;display:grid;place-items:center;border-radius:50%;background:var(--pri-l);color:var(--pri);font-weight:800;font-size:14px}.student-pic.big{width:54px;height:54px;font-size:17px}
.student-info{flex:1;min-width:0}.student-info b{display:block;font-size:15px}.student-info small{color:var(--muted)}
.status{color:var(--muted);font-size:13px}.status.present{color:var(--ok);font-weight:700}
.check-btn{padding:8px 14px;border:1px solid var(--pri);border-radius:8px;background:#fff;color:var(--pri);font-size:13px;font-weight:700;transition:.2s}
.check-btn:hover:not(:disabled){background:var(--pri);color:#fff}.check-btn:disabled{opacity:.6;cursor:default}.check-btn.selected{background:var(--pri);color:#fff}
.notice{margin:14px 0;padding:12px 14px;border-radius:10px;background:var(--pri-l);color:#34507a;font-size:14px}
.camera-box{position:relative;width:100%;aspect-ratio:4/3;margin-top:16px;overflow:hidden;border-radius:14px;background:#111}.camera-box video{width:100%;height:100%;object-fit:cover;transform:scaleX(-1)}
.camera-guide{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none}.face-frame{width:min(72%,260px);height:82%;border:3px dashed #fff;border-radius:48% 48% 42% 42%;box-shadow:0 0 0 999px rgba(0,0,0,.4)}
.scan-line{position:absolute;left:14%;right:14%;height:2px;background:var(--pri);box-shadow:0 0 14px var(--pri);animation:scan 2.6s ease-in-out infinite}@keyframes scan{0%,100%{top:14%}50%{top:84%}}
.camera-hint{position:absolute;left:12px;right:12px;bottom:12px;padding:8px 12px;border-radius:10px;color:#fff;background:rgba(0,0,0,.6);text-align:center;font-size:13px}
.countdown{min-height:28px;margin:12px 0;color:var(--pri);text-align:center;font-weight:700}
.scan-prog{height:8px;margin-top:14px;border-radius:99px;background:var(--line);overflow:hidden}.scan-prog i{display:block;width:0;height:100%;background:var(--pri);transition:width .25s linear}
.toast{position:fixed;z-index:100;bottom:26px;left:50%;padding:12px 20px;transform:translate(-50%,20px);opacity:0;pointer-events:none;border-radius:10px;color:#fff;background:#1f2a37;font-weight:600;font-size:14px;transition:.25s}.toast.show{transform:translate(-50%,0);opacity:1}
.hub-reg{width:100%;margin-top:18px;display:flex;align-items:center;gap:14px;padding:14px 16px;text-align:left;border:0;border-radius:14px;color:#fff;background:var(--pri)}.hub-reg:hover{background:var(--pri-d)}.hub-reg.shake{animation:shake .4s}
.hub-reg b{display:block;font-size:17px}.hub-reg small{opacity:.85}.hub-step{width:36px;height:36px;flex:none;display:grid;place-items:center;border-radius:50%;background:#fff;color:var(--pri);font-weight:800}.hub-go{margin-left:auto;font-size:22px}
.reg-done{margin-top:18px;display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:14px;background:var(--ok-l)}.reg-done b{display:block}.reg-done small{color:var(--muted)}
.reg-ok{width:36px;height:36px;flex:none;display:grid;place-items:center;border-radius:50%;background:var(--ok);color:#fff;font-weight:800}.reg-out{margin-left:auto;padding:7px 14px;border:1px solid var(--line);border-radius:8px;background:#fff;font-size:13px;font-weight:700}
.hub-label{margin:20px 0 -6px;color:var(--muted);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em}
.kid-card{margin-top:18px;border:1px solid var(--line);border-radius:16px;overflow:hidden}.kid-top{display:flex;align-items:center;gap:14px;padding:16px}.kid-top b{display:block;font-size:18px}.kid-top small{color:var(--muted)}
.kid-status{display:flex;align-items:center;gap:14px;padding:18px 16px}.kid-card.is-out .kid-status{color:var(--warn);background:var(--warn-l)}.kid-card.is-in .kid-status{color:var(--ok);background:var(--ok-l)}
.kid-status small{display:block;color:var(--muted);font-size:13px}.kid-status strong{display:block;font-size:22px;line-height:1.2;color:var(--text)}.kid-status em{font-style:normal;font-size:13px;color:var(--muted)}.kid-emoji{margin-left:auto;font-size:34px}
.pulse-dot{width:12px;height:12px;flex:none;border-radius:50%;background:currentColor}.hub-actions{display:flex;gap:10px;margin-top:14px}.hub-actions .btn{flex:1}
.days{display:flex;gap:6px;margin:18px 0 12px}.day{flex:1;min-width:0;padding:6px 2px 9px;border:1px solid var(--line);border-radius:10px;background:#fff;font-weight:700;font-size:14px;text-align:center}
.day small{display:block;height:12px;font-size:10px;color:var(--pri)}.day.active{background:var(--pri);border-color:var(--pri);color:#fff}.day.active small{color:#fff}
.lesson{display:flex;align-items:center;gap:12px;padding:11px 12px;margin-bottom:8px;border:1px solid var(--line);border-radius:10px}.lesson .ln{width:30px;height:30px;flex:none;display:grid;place-items:center;border-radius:8px;background:var(--pri-l);color:var(--pri);font-weight:800}
.lesson b{display:block}.lesson small{color:var(--muted)}.lesson.now{border-color:var(--pri);background:var(--pri-l)}.lesson.now .ln{background:var(--pri);color:#fff}.lesson .live{margin-left:auto;padding:3px 10px;border-radius:99px;background:var(--pri);color:#fff;font-size:12px;font-weight:700}
.free{padding:22px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:12px}
.arrive{width:100%;margin-top:16px;display:flex;align-items:center;gap:14px;padding:14px 16px;text-align:left;border:1px solid var(--pri);border-radius:14px;background:var(--pri-l)}.arrive:hover{background:#dbe9fc}
.arrive b{display:block}.arrive small{color:var(--muted);font-size:13px}.arrive-ic{width:42px;height:42px;flex:none;display:grid;place-items:center;border-radius:12px;background:var(--pri);color:#fff;font-weight:800}.arrive-ic svg{width:22px;height:22px}.arrive.done{border-color:var(--line);background:var(--ok-l)}.arrive.done .arrive-ic{background:var(--ok)}
.err-card,.ok-card{margin-top:18px;padding:24px 20px;text-align:center;border-radius:16px}.err-card{background:var(--err-l)}.ok-card{background:var(--ok-l)}
.err-ic,.ok-ic{width:60px;height:60px;margin:0 auto 12px;display:grid;place-items:center;border-radius:50%;color:#fff;font-size:30px;font-weight:800}.err-ic{background:var(--err)}.ok-ic{background:var(--ok)}.ok-ic svg{width:30px;height:30px}
.err-card h3,.ok-card h3{margin-bottom:6px;font-size:21px}.err-card p,.ok-card p{color:#455468;font-size:14.5px}
@media(max-width:900px){.live-card{grid-template-columns:1fr}.aud,.rows,.stack,.st-wrap{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}.hero{padding:30px 22px}}
@media(max-width:680px){.nav-links{display:none}.menu-btn{display:flex}.nav .btn-ghost{padding:9px 16px}.role-grid,.role-grid.two{grid-template-columns:1fr}.modal{padding:20px}.student{flex-wrap:wrap}.check-btn{margin-left:54px}.foot{flex-direction:column}.faq-a p{padding-left:20px}.cells{gap:4px}}
  
/* Uchta tugma — sahifaning eng tepasida */
main{display:flex;flex-direction:column}main>*{width:100%}
#kim{order:-1;padding-top:22px}#kim .sec-head{display:none}
.aud{gap:12px}
.aud-card{background:var(--pri);border-color:var(--pri);border-radius:14px;box-shadow:0 4px 14px rgba(47,128,237,.3)}
.aud-card:hover,.aud-card:focus-visible{background:var(--pri-d);border-color:var(--pri-d);transform:translateY(-2px);box-shadow:0 8px 20px rgba(47,128,237,.4)}
.aud-inner{flex-direction:row;align-items:center;gap:14px;padding:14px 18px}.aud-inner>div:nth-child(2){flex:1}
